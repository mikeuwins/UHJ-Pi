line_x = width_center_x - half_w*0.75; gfx_line(line_x, width_meter_y - 5, line_x, width_meter_y + meter_h + 5);
line_x = width_center_x - half_w*0.50; gfx_line(line_x, width_meter_y - 5, line_x, width_meter_y + meter_h + 5);
line_x = width_center_x - half_w*0.25; gfx_line(line_x, width_meter_y - 5, line_x, width_meter_y + meter_h + 5);
// Right 25, 50, 75, 100
line_x = width_center_x + half_w*0.25; gfx_line(line_x, width_meter_y - 5, line_x, width_meter_y + meter_h + 5);
line_x = width_center_x + half_w*0.50; gfx_line(line_x, width_meter_y - 5, line_x, width_meter_y + meter_h + 5);
line_x = width_center_x + half_w*0.75; gfx_line(line_x, width_meter_y - 5, line_x, width_meter_y + meter_h + 5);
line_x = width_center_x + half_w;      gfx_line(line_x, width_meter_y - 5, line_x, width_meter_y + meter_h + 5);

// Numeric labels under width dipole
gfx_setfont(1, "Arial", 8);
// Left side
gfx_x = width_center_x - half_w - 12; gfx_y = width_meter_y + meter_h + 8; gfx_printf("100");
gfx_x = width_center_x - half_w*0.75 - 8; gfx_y = width_meter_y + meter_h + 8; gfx_printf("75");
gfx_x = width_center_x - half_w*0.5 - 8; gfx_y = width_meter_y + meter_h + 8; gfx_printf("50");
gfx_x = width_center_x - half_w*0.25 - 8; gfx_y = width_meter_y + meter_h + 8; gfx_printf("25");
// Center (0)
gfx_x = width_center_x - 3; gfx_y = width_meter_y + meter_h + 8; gfx_printf("0");
// Right side
gfx_x = width_center_x + half_w*0.25 - 3; gfx_y = width_meter_y + meter_h + 8; gfx_printf("25");
gfx_x = width_center_x + half_w*0.5 - 3; gfx_y = width_meter_y + meter_h + 8; gfx_printf("50");
gfx_x = width_center_x + half_w*0.75 - 3; gfx_y = width_meter_y + meter_h + 8; gfx_printf("75");
gfx_x = width_center_x + half_w - 3; gfx_y = width_meter_y + meter_h + 8; gfx_printf("100");

// Mouse click to reset peak
(gfx_mouse_x != last_mouse_x || gfx_mouse_y != last_mouse_y || gfx_mouse_cap) ? (
  (gfx_mouse_cap & 1) ? (
    peak_area_x = meter_x + meter_w + 5;
    peak_area_w = 70;
    (gfx_mouse_x >= peak_area_x && gfx_mouse_x <= peak_area_x + peak_area_w &&
     gfx_mouse_y >= width_meter_y - 5 && gfx_mouse_y <= width_meter_y + meter_h + 5) ? (
      width_inj_peak = -60;
      width_inj_peak_counter = 0;
    );
  );
  last_mouse_x = gfx_mouse_x;
  last_mouse_y = gfx_mouse_y;
);

// Width injection peak readout
(width_inj_peak > 0) ? (
  gfx_set(1.0, 0.0, 0.0, 1.0);
  gfx_rect(peak_x - 2, width_meter_y - 2, 45, meter_h + 4);
);
gfx_set(1.0, 1.0, 1.0, 1.0);
gfx_setfont(1, "Arial", 11);
gfx_x = peak_x; gfx_y = width_meter_y + 5;
sprintf(#width_str, "%.1f", max(width_inj_peak, -60));
gfx_printf(#width_str);

// Width injection label removed (formula not needed)
); // End meters_on block
// =====================================================
//                  DIMENSION  (ORIGINAL)
// =====================================================

// ---------- Sliders ----------
@slider
// (VHAP)
vhap_trim   = exp(log(10)*(slider1/20));
vhap_morph  = slider2 * 0.01;
vhap_solo   = slider3|0;

// Forward Preference
k    = slider4;
fpHP = max(10, min(slider5, srate*0.333));

// Shelves / mode / presets / gains
shelves_mode = slider6|0;       // 0=Off, 1=2D, 2=3D
psy_on       = slider7|0;
tf           = max(10, min(slider8, srate*0.333));
gLF          = slider9;
gHF          = slider10;

// Derived flags
s_on = shelves_mode > 0;
dim3 = shelves_mode == 2;

// Output trim
out_lin = exp(log(10)*(slider11/20));

// Meters enable/disable
meters_on = slider12|0;

// VHAP is always enabled (internal state)
vhap_enable = 1;

// FP HP coeffs
inj_hp_a = exp(-2*$pi*fpHP/srate);
inj_hp_b = 1 - inj_hp_a;

// Dev-only LF meter coeffs for synthesized Z'
dbg_lf_a = exp(-2*$pi*dbg_lf_fc/srate);
dbg_lf_b = 1 - dbg_lf_a;
// reset throttle
dbg_frame_ctr = 0;
// Width RMS meter coefficient (50 ms time constant)
y_tc = 0.05;
y_rms_a = exp(-1/(y_tc*srate));

// Psycho presets (per-channel dB offsets)
psyW_HF=0; psyX_HF=0; psyY_HF=0; psyZ_HF=0;
psyW_LF=0; psyX_LF=0; psyY_LF=0; psyZ_LF=0;

psy_on ? (
  // 2D vs 3D HF targets (Gerzon-ish)
  psyW_HF = dim3 ? 3.01 : 1.76;
  psyX_HF = dim3 ? 1.76 : -1.25;
  psyY_HF = dim3 ? 1.76 : -1.25;
  psyZ_HF = dim3 ? 1.76 : 0.00;
  // gentle counter-LF to keep overall power closer
  psyW_LF = -psyW_HF*0.6;
  psyX_LF = -psyX_HF*0.6;
  psyY_LF = -psyY_HF*0.6;
  psyZ_LF = -psyZ_HF*0.6;
);

// Per-channel dB targets (global + preset offsets)
gLF_W=gLF+psyW_LF; gHF_W=gHF+psyW_HF;
gLF_X=gLF+psyX_LF; gHF_X=gHF+psyX_HF;
gLF_Y=gLF+psyY_LF; gHF_Y=gHF+psyY_HF;
gLF_Z=gLF+psyZ_LF; gHF_Z=gHF+psyZ_HF;

// Tilt split coeffs
simp_a = exp(-2*$pi*tf/srate);
simp_b = 1 - simp_a;

// Pre-calculate gain conversions (moved from @sample for performance)
gLF_lin_W = exp(log(10)*(gLF_W/20)); gHF_lin_W = exp(log(10)*(gHF_W/20));
gLF_lin_X = exp(log(10)*(gLF_X/20)); gHF_lin_X = exp(log(10)*(gHF_X/20));
gLF_lin_Y = exp(log(10)*(gLF_Y/20)); gHF_lin_Y = exp(log(10)*(gHF_Y/20));
gLF_lin_Z = exp(log(10)*(gLF_Z/20)); gHF_lin_Z = exp(log(10)*(gHF_Z/20));

// ---------- Audio ----------
@sample
// --- Inputs ---
W=spl0; X=spl1; Y=spl2; Z=spl3;

Z_original = Z;
// --- Stage 1: B-VHAP injection (pre) ---
// Fill ring buffers for all four lanes: W, X, Y, Z
bv_rbW[bv_wr]=W; bv_rbX[bv_wr]=X; bv_rbY[bv_wr]=Y; bv_rbZ[bv_wr]=Z; bv_head=bv_wr; bv_wr=(bv_wr+1)&BV_RINGMSK;

// Convolve with all four lanes
bv_zw = bv_firdot(bv_rbW, bv_head, bvZW, bvZW_b, bvZW_e);
bv_zx = bv_firdot(bv_rbX, bv_head, bvZX, bvZX_b, bvZX_e);
bv_zy = bv_firdot(bv_rbY, bv_head, bvZY, bvZY_b, bvZY_e);
bv_zd = bv_firdot(bv_rbZ, bv_head, bvZD, bvZD_b, bvZD_e);

// Boost ZW/ZX/ZY when original Z is zero (UHJ case) - 2x to compensate for missing ZΔ LF
(abs(Z_original) < 0.0001) ? (
  bv_zw = bv_zw * 2.0;
  bv_zx = bv_zx * 2.0;
  bv_zy = bv_zy * 2.0;
);

// Synthesize Z' from all four lanes at kernel-normalized level
Z_prime_full = (bv_zw + bv_zx + bv_zy + bv_zd) * (BV_G * vhap_enable);
(abs(Z_prime_full) > Z_injected_peak) ? (Z_injected_peak = abs(Z_prime_full)) : 0;

// Correct B-VHAP: Z_out = Z_original + morph × (Z' - Z_original), where Z' has trim applied
// Z' should have trim applied first, then morph between Z_original and Z'_trimmed
Z_prime_trimmed = Z_prime_full * vhap_trim;  // Apply trim to Z' first
// Apply gentle soft limiter to synthesized Z' to avoid distortion
Z_prime_trimmed = softlim(Z_prime_trimmed);
Z_delta = Z_prime_trimmed - Z_original;      // Delta between trimmed Z' and original
Z_morph = Z_original + vhap_morph * Z_delta; // Morph: 0=original, 1=full Z'

// VHAP Solo modes
vhap_solo ? (
  // Solo: output synthesized Z' with trim applied (pure Z' only, no blending)
  Z_after_vhap = Z_prime_trimmed;  // For meter calculation
  // Debug LF metering disabled for performance (was causing stutter)
  // Solo: output trimmed+soft-limited Z' only in Z channel, silence others
  spl0=0; spl1=0; spl2=0; spl3=Z_prime_trimmed;
) : (
  // Normal mode: use morphed Z for output and meter
  Z = Z_morph;
  Z_after_vhap = Z;

  // Debug LF metering disabled for performance (was causing stutter)

  // --- Stage 2: Dimension (original, unchanged) ---

  // +90°(X) via 4× first-order all-pass (inline)
  x90 = X;
  tmp = -h_d1*x90 + x90_s1_xm + h_d1*x90_s1_ym; x90_s1_xm=x90; x90_s1_ym=tmp; x90=tmp + tiny;
  tmp = -h_d2*x90 + x90_s2_xm + h_d2*x90_s2_ym; x90_s2_xm=x90; x90_s2_ym=tmp; x90=tmp + tiny;
  tmp = -h_d3*x90 + x90_s3_xm + h_d3*x90_s3_ym; x90_s3_xm=x90; x90_s3_ym=tmp; x90=tmp + tiny;
  tmp = -h_d4*x90 + x90_s4_xm + h_d4*x90_s4_ym; x90_s4_xm=x90; x90_s4_ym=tmp; x90=tmp + tiny;

  // HP on injected term (only), then inject into Y
  inj_lp = inj_hp_a*inj_lp + inj_hp_b*x90;
  inj = (x90 - inj_lp) * k;
  
  // Measure the width injection term magnitude (throttled for performance, skip if meters off)
  meters_on ? (
    width_inj = abs(inj);
    // Throttle log10 calculation to every 8 samples (still smooth for meter)
    width_inj_throttle += 1;
    (width_inj_throttle >= 8) ? (
      width_inj_throttle = 0;
      width_inj_db = 20 * log10(max(width_inj, 0.000001));
      // Smooth the width injection meter
      !width_inj_smooth ? width_inj_smooth = width_inj_db;
      width_inj_db > width_inj_smooth ? (
        width_inj_smooth = width_inj_db;  // Instant attack
      ) : (
        width_inj_smooth = width_inj_smooth * 0.92 + width_inj_db * 0.08;
        (width_inj_smooth < -55) ? width_inj_smooth = width_inj_db;
      );
      // Peak hold for width injection (counter increment moved to @block)
      width_inj_db > width_inj_peak ? (
        width_inj_peak = width_inj_db;
        width_inj_peak_counter = 0;
      );
    ) : 0;
  );

  Wp=W; Xp=X; Yp=Y+inj; Zp=Z;

  // SIMPLE TILT shelves (first-order split), per channel
  // (gain conversions moved to @slider for performance)

  s_on ? (
    // W
    w_lp = simp_a*w_lp + simp_b*Wp;
    Wp   = gLF_lin_W*w_lp + gHF_lin_W*(Wp - w_lp);
    // X
    x_lp = simp_a*x_lp + simp_b*Xp;
    Xp   = gLF_lin_X*x_lp + gHF_lin_X*(Xp - x_lp);
    // Y
    y_lp = simp_a*y_lp + simp_b*Yp;
    Yp   = gLF_lin_Y*y_lp + gHF_lin_Y*(Yp - y_lp);
    // Z (3D only)
    dim3 ? (
      z_lp = simp_a*z_lp + simp_b*Zp;
      Zp   = gLF_lin_Z*z_lp + gHF_lin_Z*(Zp - z_lp);
    );
  );

  // Output (with trim)
  spl0 = Wp * out_lin;
  spl1 = Xp * out_lin;
  spl2 = Yp * out_lin;
  spl3 = Zp * out_lin;

  // Capture final Z for meter (after all processing)
  Z_final = spl3;

// Meter sample tracking removed for performance
);
