/*
ATK FOA Transform — Dimension
FOA (FuMa) W,X,Y,Z → W',X',Y',Z' (feed to PHJ decoder)

Unified build:
  Stage 1 (pre): B-VHAP (Lee) — synthesise pseudo-height Z′ from W/X/Y via FIR (1024 taps)
  Stage 2:       Dimension (your original) — Forward Preference (+HP) and Psycho Shelves (WXYZ, last)

Kernels (macOS default paths):
  ~/Library/Application Support/ATK/kernels/FOA/transforms/b-vhap/<fs>/1024/0100/BVHAP_Z.wav
    Interleaved per tap: [ZW, ZX, ZY, Δ]  (Δ unused)

Author: you (with ChatGPT)
Version: 1.0-unified
*/

desc:ATK FOA Transform — Dimension

import ../../libraries/atk/atk.jsfx-inc

in_pin:W
in_pin:X
in_pin:Y
in_pin:Z

out_pin:W'
out_pin:X'
out_pin:Y'
out_pin:Z'

// -------------------- UI --------------------
// (Added) VHAP pre-stage (on top)
slider1:70<0,100,1>VHAP Amount (%)    
slider2:0.0<-12.0,12.0,0.1>VHAP Boost (dB)
slider3:0<0,1,1{Z-Solo Off,Z-Solo On}>Z-Solo      

// (Original Dimension controls, unchanged order/text)
slider4:0.00<0.00,0.70,0.01>Forward Preference (k)
slider5:180<80,400,1>Forward Pref HP (Hz)

slider6:0<0,2,1{Off,2D (WXY),3D (WXYZ)}>Psycho Shelves Mode
slider7:0<0,1,1{Off,On}>Gerzon Presets
slider8:400<100,3000,10>Transition Freq (Hz)
slider9:0<-6,6,0.1>LF Gain (dB)
slider10:0<-6,6,0.1>HF Gain (dB)

slider11:0<-18,18,0.1>Output Trim (dB)

// Meter controls
slider12:100<10,1000,1>Meter Sample Time (ms)
slider13:100<10,1000,1>Meter Peak Hold (ms)

options:no_meter

// =====================================================
//                B-VHAP PRE-STAGE (TD 1024)
// =====================================================
@init
// ----- B-VHAP FIR constants / buffers -----
BV_N = 1024;
BV_EPS = 0.000000001;

// path + interleaved buffer
bvFN = 1;
bvImp = 65536*1;          // BV_N * 4 floats

// deinterleaved lanes
bvZW = 65536*2;
bvZX = 65536*3;
bvZY = 65536*4;

// supports [beg,end)
bvZW_b=0; bvZW_e=1;
bvZX_b=0; bvZX_e=1;
bvZY_b=0; bvZY_e=1;

// donor ring buffers
BV_RINGSZ = 8192; BV_RINGMSK = BV_RINGSZ - 1;
bv_wr=0; memset(bv_rbW,0,BV_RINGSZ); memset(bv_rbX,0,BV_RINGSZ); memset(bv_rbY,0,BV_RINGSZ);

// normaliser
BV_G = 1.0;
Z_injected_peak = 0;

// ----- DIMENSION constants / buffers -----
// Niemitalo (+90°) constants
h_d1 = 0.4021921162426;
h_d2 = 0.8561710882420;
h_d3 = 0.9722909545651;
h_d4 = 0.9952884791278;

// AP states for +90°(X)
x90_s1_xm=0; x90_s1_ym=0;
x90_s2_xm=0; x90_s2_ym=0;
x90_s3_xm=0; x90_s3_ym=0;
x90_s4_xm=0; x90_s4_ym=0;

// FP high-pass (on injected term) state/coeffs
inj_lp=0; inj_hp_a=0; inj_hp_b=1;

// Simple tilt (one-pole split) states & coeffs
simp_a=0; simp_b=1;
w_lp=0; x_lp=0; y_lp=0; z_lp=0;

// Denormal preventer
tiny = 0.000000000000000000000001; // 1e-24 equivalent

// Meter variables
meter_ln = 5;              // channels (W,X,Y,Z,ZΔ)
meter_scalex = 30;         // pixels for labels
meter_maxsamples = 524288; // Start after bvZY
meter_peaks = meter_maxsamples + meter_ln;
meter_pholds = meter_peaks + meter_ln;
meter_pctr = meter_pholds + meter_ln;

memset(meter_maxsamples, 0, meter_ln);
i = 0;
loop(meter_ln,
  meter_peaks[i] = -60;
  meter_pholds[i] = -60;
  i += 1;
);
memset(meter_pctr, 0, meter_ln);
meter_bscnt = 0;

// Helper function to scale dB to screen position
function scale_db(db_val) (
  db_val <= -60 ? 0 : db_val >= 0 ? 1 : (db_val + 60) / 60;
);

// small helpers (no pointers)
function bv_deint(base, N, dstZW, dstZX, dstZY)
(
  i=0; j=0;
  loop(N,
    mem[dstZW + i] = mem[base + j];     // ZW
    mem[dstZX + i] = mem[base + j + 1]; // ZX
    mem[dstZY + i] = mem[base + j + 2]; // ZY
    j += 4; i += 1;
  );
);

bv_sup_b=0; bv_sup_e=1;
function bv_support(base, N)
(
  bv_sup_b=N; bv_sup_e=-1; i=0;
  loop(N,
    (abs(mem[base+i]) > BV_EPS) ? (
      (i<bv_sup_b) ? bv_sup_b=i : 0;
      (i>bv_sup_e) ? bv_sup_e=i : 0;
    ) : 0;
    i += 1;
  );
  (bv_sup_e<0) ? (bv_sup_b=0; bv_sup_e=0) : 0;
  bv_sup_e += 1; // end exclusive
);

function bv_l2(base,b,e)
(
  acc=0; i=b; loop(e-b, acc += mem[base+i]*mem[base+i]; i+=1;); acc;
);

function bv_firdot(rb*, head, hbase, beg, end_)
(
  acc=0; i=beg; idx=(head-beg)&BV_RINGMSK;
  loop(end_-beg,
    acc += rb[idx] * mem[hbase + i];
    idx = (idx - 1) & BV_RINGMSK;
    i += 1;
  );
  acc;
);

// load kernels
function bv_load()
(
  fs_i = floor(srate+0.5);
  sprintf(bvFN, "ATK/kernels/FOA/transforms/b-vhap/%i/%i/0100/BVHAP_Z.wav", fs_i, BV_N);
  total = BV_N*4;
  memset(bvImp, 0, total);
  readKernelImpulseFromFile(bvFN, bvImp);

  bv_deint(bvImp, BV_N, bvZW, bvZX, bvZY);

  bv_support(bvZW,BV_N); bvZW_b=bv_sup_b; bvZW_e=bv_sup_e;
  bv_support(bvZX,BV_N); bvZX_b=bv_sup_b; bvZX_e=bv_sup_e;
  bv_support(bvZY,BV_N); bvZY_b=bv_sup_b; bvZY_e=bv_sup_e;

  eZW = bv_l2(bvZW,bvZW_b,bvZW_e);
  eZX = bv_l2(bvZX,bvZX_b,bvZX_e);
  eZY = bv_l2(bvZY,bvZY_b,bvZY_e);
  eTot = eZW + eZX + eZY; (eTot<=0) ? (eTot=1):0;
  BV_G = 1/sqrt(eTot);
  (BV_G<0.25) ? BV_G=0.25 : 0;
  (BV_G>8.0)  ? BV_G=8.0  : 0;

  bv_wr=0; memset(bv_rbW,0,BV_RINGSZ); memset(bv_rbX,0,BV_RINGSZ); memset(bv_rbY,0,BV_RINGSZ);
);

bv_load(); bv_last_sr = srate;

@block
(bv_last_sr != srate) ? ( bv_last_sr = srate; bv_load(); ) : 0;

// Meter block processing
meter_bscnt > meter_sampletime ? (
  ibl = 0;
  loop(meter_ln,
    // Convert to dB (20*log10) with B-format correction
    meter_maxsamples[ibl] > 0 ? (
      meter_peaks[ibl] = max(log(meter_maxsamples[ibl]) * 8.685889638065035 - 3, -60);
    ) : (
      meter_peaks[ibl] = -60;
    );
    // Update peak hold or increment counter
    meter_pholds[ibl] < meter_peaks[ibl] ? (
      meter_pholds[ibl] = meter_peaks[ibl];
      meter_pctr[ibl] = 0;
    ) : (
      meter_pctr[ibl] += 1;
      // Peak hold expires after timeout
      meter_pctr[ibl] > meter_phold ? (meter_pholds[ibl] = meter_peaks[ibl];);
    );
    meter_maxsamples[ibl] = 0;
    ibl += 1;
  );
  meter_bscnt = 0;
);
meter_bscnt += samplesblock;

@gfx 400 400
// Calculate bar width (with space between bars)
myx = floor((gfx_w - meter_scalex) / meter_nch) - 2;
x = meter_scalex;
mult = gfx_h / abs(meter_mindb);
gfx_clear = 0x000000;
gfx_setfont(1, "Arial", 11);


// Draw gray padding bar
gfx_set(0.7, 0.7, 0.7, 1.0);
gfx_rect(0, 0, gfx_w, 10);

// Draw peak level readouts
peak_x = meter_scalex;
i = 0;
loop(meter_nch,
  db_val = meter_pholds[i];
  db_display = max(db_val, -60);
  (db_val > -3) ? (
    gfx_set(1.0, 0.0, 0.0, 1.0);
    gfx_rect(peak_x, 11, myx, 14);
  );
  gfx_set(1.0, 1.0, 1.0, 1.0);
  gfx_x = peak_x + myx/2 - 14;
  gfx_y = 13;
  gfx_printf("%.1f", db_display);
  peak_x += myx + 2;
  i += 1;
);

// Draw meters
i = 0;
loop(meter_nch,
  db = meter_peaks[i];
  db_hold = meter_pholds[i];
  y = scale_db(db) * meter_h;
  y_hold = scale_db(db_hold) * meter_h;

  // Draw the bar in 80s-style LED segments
  (y > 0) ? (
    y_total = floor(y);
    seg_height = 4;
    seg_gap = 1;
    seg_count = floor(y_total / (seg_height + seg_gap));
    seg = 0;
    seg_y = meter_top + meter_h;
    loop(seg_count,
      seg_y -= seg_height + seg_gap;
      (seg_y < meter_top + meter_h - scale_db(-3) * meter_h) ? (
        gfx_set(1.0, 0.0, 0.0, 1.0);
      ) : (seg_y < meter_top + meter_h - scale_db(-12) * meter_h) ? (
        gfx_set(1.0, 0.5, 0.0, 1.0);
      ) : (
        gfx_set(0.0, 1.0, 1.0, 1.0);
      );
      gfx_rect(x, seg_y, myx, seg_height);
      seg += 1;
    );
  );

  // Peak hold indicator (white line)
  (y_hold > 0 && y_hold <= meter_h) ? (
    gfx_set(1.0, 1.0, 1.0, 1.0);
    gfx_line(x, meter_top + meter_h - y_hold, x + myx, meter_top + meter_h - y_hold);
  );

  x += myx + 2;
  i += 1;
);

// Channel labels
label_y = gfx_h - label_h / 2 - 6;
gfx_set(1.0, 1.0, 1.0, 1.0);
x = meter_scalex;
i = 0;
loop(meter_nch,
  gfx_x = x + myx/2 - (i == 4 ? 12 : 5);
  gfx_y = label_y;
  (i == 4) ? (
    gfx_printf("%s", "ΔZ");
  ) : (
    gfx_printf("%c", i == 0 ? 87 : i == 1 ? 88 : i == 2 ? 89 : 90);
  );
  x += myx + 2;
  i += 1;
);

// dB scale on the left
gfx_set(0.7, 0.7, 0.7, 1.0);
y_pos = meter_top + meter_h - scale_db(0) * meter_h;
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 18) / 2; gfx_y += 1; gfx_printf("0");
y_pos = meter_top + meter_h - scale_db(-6) * meter_h;
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 20) / 2; gfx_y += 1; gfx_printf("-6");
y_pos = meter_top + meter_h - scale_db(-12) * meter_h;
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 22) / 2; gfx_y += 1; gfx_printf("-12");
y_pos = meter_top + meter_h - scale_db(-18) * meter_h;
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 22) / 2; gfx_y += 1; gfx_printf("-18");
y_pos = meter_top + meter_h - scale_db(-24) * meter_h;
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 22) / 2; gfx_y += 1; gfx_printf("-24");
y_pos = meter_top + meter_h - scale_db(-30) * meter_h;
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 22) / 2; gfx_y += 1; gfx_printf("-30");
y_pos = meter_top + meter_h - scale_db(-36);
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 22) / 2; gfx_y += 1; gfx_printf("-36");
y_pos = meter_top + meter_h - scale_db(-42);
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 22) / 2; gfx_y += 1; gfx_printf("-42");
y_pos = meter_top + meter_h - scale_db(-48);
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 22) / 2; gfx_y += 1; gfx_printf("-48");
y_pos = meter_top + meter_h - scale_db(-54);
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 22) / 2; gfx_y += 1; gfx_printf("-54");
y_pos = meter_top + meter_h - scale_db(-60);
gfx_x = 0; gfx_y = y_pos; gfx_lineto(meter_scalex - 3, y_pos);
gfx_x = (meter_scalex - 22) / 2; gfx_y += 1; gfx_printf("-60");

// =====================================================
//                  DIMENSION  (ORIGINAL)
// =====================================================

// ---------- Sliders ----------
@slider
// (VHAP)
vhap_amount = slider1 * 0.01;
vhap_boost  = exp(log(10)*(slider2/20));
vhap_solo   = slider3|0;

// Forward Preference
k    = slider4;
fpHP = max(10, min(slider5, srate*0.333));

// Shelves / mode / presets / gains
shelves_mode = slider6|0;       // 0=Off, 1=2D, 2=3D
psy_on       = slider7|0;
tf           = max(10, min(slider8, srate*0.333));
gLF          = slider9;
gHF          = slider10;

// Derived flags
s_on = shelves_mode > 0;
dim3 = shelves_mode == 2;

// Output trim
out_lin = exp(log(10)*(slider11/20));

// VHAP is always enabled (internal state)
vhap_enable = 1;

// FP HP coeffs
inj_hp_a = exp(-2*$pi*fpHP/srate);
inj_hp_b = 1 - inj_hp_a;

// Psycho presets (per-channel dB offsets)
psyW_HF=0; psyX_HF=0; psyY_HF=0; psyZ_HF=0;
psyW_LF=0; psyX_LF=0; psyY_LF=0; psyZ_LF=0;

psy_on ? (
  // 2D vs 3D HF targets (Gerzon-ish)
  psyW_HF = dim3 ? 3.01 : 1.76;
  psyX_HF = dim3 ? 1.76 : -1.25;
  psyY_HF = dim3 ? 1.76 : -1.25;
  psyZ_HF = dim3 ? 1.76 : 0.00;
  // gentle counter-LF to keep overall power closer
  psyW_LF = -psyW_HF*0.6;
  psyX_LF = -psyX_HF*0.6;
  psyY_LF = -psyY_HF*0.6;
  psyZ_LF = -psyZ_HF*0.6;
);

// Per-channel dB targets (global + preset offsets)
gLF_W=gLF+psyW_LF; gHF_W=gHF+psyW_HF;
gLF_X=gLF+psyX_LF; gHF_X=gHF+psyX_HF;
gLF_Y=gLF+psyY_LF; gHF_Y=gHF+psyY_HF;
gLF_Z=gLF+psyZ_LF; gHF_Z=gHF+psyZ_HF;

// Tilt split coeffs
simp_a = exp(-2*$pi*tf/srate);
simp_b = 1 - simp_a;

// Meter params
meter_nch = 5;
meter_sampletime = slider12 * srate / 1000;
meter_mindb = -60;
meter_phold = slider13;

// ---------- Audio ----------
@sample
// --- Inputs ---
W=spl0; X=spl1; Y=spl2; Z=spl3;

// --- Stage 1: B-VHAP injection (pre) ---
bv_rbW[bv_wr]=W; bv_rbX[bv_wr]=X; bv_rbY[bv_wr]=Y; bv_head=bv_wr; bv_wr=(bv_wr+1)&BV_RINGMSK;

bv_zw = bv_firdot(bv_rbW, bv_head, bvZW, bvZW_b, bvZW_e);
bv_zx = bv_firdot(bv_rbX, bv_head, bvZX, bvZX_b, bvZX_e);
bv_zy = bv_firdot(bv_rbY, bv_head, bvZY, bvZY_b, bvZY_e);

Z_injected_raw = (bv_zw + bv_zx + bv_zy) * (BV_G * vhap_amount * vhap_boost * vhap_enable);
(abs(Z_injected_raw) > Z_injected_peak) ? (Z_injected_peak = abs(Z_injected_raw)) : 0;

// Soft limit the injected Z to prevent overload
lim_thresh = 0.95;
Z_injected = (abs(Z_injected_raw) > lim_thresh) ? (Z_injected_raw * (1 - (1-lim_thresh) * tanh((abs(Z_injected_raw)-lim_thresh) / 0.1))) : Z_injected_raw;

// Z-Solo: audition injected component only (bypass Dimension) - feed to W for proper periphonic decoding
vhap_solo ? (
  spl0=Z_injected; spl1=0; spl2=0; spl3=0;
) : (

  // Feed Dimension with Z + injected (W/X/Y dry)
  Z = Z + Z_injected;

  // --- Stage 2: Dimension (original, unchanged) ---

  // +90°(X) via 4× first-order all-pass (inline)
  x90 = X;
  tmp = -h_d1*x90 + x90_s1_xm + h_d1*x90_s1_ym; x90_s1_xm=x90; x90_s1_ym=tmp; x90=tmp + tiny;
  tmp = -h_d2*x90 + x90_s2_xm + h_d2*x90_s2_ym; x90_s2_xm=x90; x90_s2_ym=tmp; x90=tmp + tiny;
  tmp = -h_d3*x90 + x90_s3_xm + h_d3*x90_s3_ym; x90_s3_xm=x90; x90_s3_ym=tmp; x90=tmp + tiny;
  tmp = -h_d4*x90 + x90_s4_xm + h_d4*x90_s4_ym; x90_s4_xm=x90; x90_s4_ym=tmp; x90=tmp + tiny;

  // HP on injected term (only), then inject into Y
  inj_lp = inj_hp_a*inj_lp + inj_hp_b*x90;
  inj = (x90 - inj_lp) * k;

  Wp=W; Xp=X; Yp=Y+inj; Zp=Z;

  // SIMPLE TILT shelves (first-order split), per channel
  gLF_lin_W = exp(log(10)*(gLF_W/20)); gHF_lin_W = exp(log(10)*(gHF_W/20));
  gLF_lin_X = exp(log(10)*(gLF_X/20)); gHF_lin_X = exp(log(10)*(gHF_X/20));
  gLF_lin_Y = exp(log(10)*(gLF_Y/20)); gHF_lin_Y = exp(log(10)*(gHF_Y/20));
  gLF_lin_Z = exp(log(10)*(gLF_Z/20)); gHF_lin_Z = exp(log(10)*(gHF_Z/20));

  s_on ? (
    // W
    w_lp = simp_a*w_lp + simp_b*Wp;
    Wp   = gLF_lin_W*w_lp + gHF_lin_W*(Wp - w_lp);
    // X
    x_lp = simp_a*x_lp + simp_b*Xp;
    Xp   = gLF_lin_X*x_lp + gHF_lin_X*(Xp - x_lp);
    // Y
    y_lp = simp_a*y_lp + simp_b*Yp;
    Yp   = gLF_lin_Y*y_lp + gHF_lin_Y*(Yp - y_lp);
    // Z (3D only)
    dim3 ? (
      z_lp = simp_a*z_lp + simp_b*Zp;
      Zp   = gLF_lin_Z*z_lp + gHF_lin_Z*(Zp - z_lp);
    );
  );

  // Output (with trim)
  spl0 = Wp * out_lin;
  spl1 = Xp * out_lin;
  spl2 = Yp * out_lin;
  spl3 = Zp * out_lin;
);

// Meter sampling (post-processing)
meter_maxsamples[0] = max(meter_maxsamples[0], abs(spl0));
meter_maxsamples[1] = max(meter_maxsamples[1], abs(spl1));
meter_maxsamples[2] = max(meter_maxsamples[2], abs(spl2));
meter_maxsamples[3] = max(meter_maxsamples[3], abs(spl3));
meter_maxsamples[4] = max(meter_maxsamples[4], abs(Z_injected));
