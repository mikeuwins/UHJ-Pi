desc:ATK VHAP* - FOA Z Pseudo-Height (single-kernel, fixed taps, stable r1)
author: you (with ChatGPT)
version: 1.0r1-stable
chans: 4
in_pin:W in
in_pin:X in
in_pin:Y in
in_pin:Z in
out_pin:W out
out_pin:X out
out_pin:Y out
out_pin:Z out

/*
Goal of this handover build:
- Your original behaviour and controls, kept intact.
- Only surgical fixes: ring pointer advance, head index for convolution, and tiny anti-denormal in hot paths.
- No meters, no output trim, no extra features.
- TAPS kept at 97 (your smoothest).
*/

slider1:50<0,100,1>Upward Preference (U)
slider2:700<200,1500,1>Split f1 (Hz)
slider3:4000<2500,8000,1>Split f2 (Hz)
slider4:0.60<0,1,0.01>Max Z mid injection (beta_m cap)
slider5:0.90<0,1,0.01>Max Z high injection (beta_h cap)
slider6:0.20<0,2,0.01>Decor mid delay (ms)
slider7:0.40<0,2,0.01>Decor high delay (ms)
slider8:1.00<0,1,0.01>Dry/Wet (Z transform)

@init
twoPi = 2*$pi;
TAPS = 97; // odd, linear-phase; group delay = (TAPS-1)/2
tiny = 0.000000000000001; // ~1e-15 anti-denormal (safe, inaudible)

// Memory layout
coeff1_base = 0;     // LP @ f1
coeff2_base = 4096;  // LP @ f2

bufW_base = 8192;
bufX_base = bufW_base + 8192;
bufY_base = bufX_base + 8192;
bufZ_base = bufY_base + 8192;

// decor delay lines
dXm_base = bufZ_base + 8192;
dYm_base = dXm_base + 1024;
dXh_base = dYm_base + 1024;
dYh_base = dXh_base + 1024;

buf_mask = 8192 - 1;
ptrW=0; ptrX=0; ptrY=0; ptrZ=0;

dXm_ptr=0; dYm_ptr=0; dXh_ptr=0; dYh_ptr=0;
dXm_mask=1024-1; dYm_mask=1024-1; dXh_mask=1024-1; dYh_mask=1024-1;

// donor balance (as before)
gW_mid_base = 0.60; gX_mid_base = 0.20; gY_mid_base = 0.20;
gW_hi_base  = 0.65; gX_hi_base  = 0.175; gY_hi_base  = 0.175;

// FIR design (windowed-sinc LP)
function sinc(x) ( x == 0 ? 1 : sin($pi*x)/($pi*x); );

function design_lp(fc, taps, base)
(
  taps |= 1; // ensure odd
  M = taps - 1;
  fn = fc / (srate/2);
  i=0;
  while (i < taps) (
    n = i - M*0.5;
    h = 2*fn * sinc(2*fn*n);       // ideal LP
    w = 0.54 - 0.46*cos(twoPi*i/M);// Hamming window
    mem[base + i] = h*w;
    i += 1;
  );
  // normalize DC gain
  sum=0; i=0; while (i<taps) ( sum += mem[base+i]; i+=1; );
  sum != 0 ? (
    g = 1.0/sum;
    i=0; while (i<taps) ( mem[base+i] *= g; i+=1; );
  );
);

// Denormal-safe convolution. headIdx = last-written sample.
function conv_dot(baseBuf, headIdx, baseCoef, taps)
(
  acc = 0;
  i=0;
  while (i < taps) (
    idx = (headIdx - i) & buf_mask;
    s   = mem[baseBuf + idx];
    s  += tiny; s -= tiny; // anti-denormal kick
    acc += s * mem[baseCoef + i];
    i += 1;
  );
  acc;
);

// Return new write pointers (args are by value in JSFX)
function push_ring(baseBuf, ptr, x)
(
  x += tiny; x -= tiny;
  mem[baseBuf + ptr] = x;
  (ptr + 1) & buf_mask;
);

function delay_push(base, ptr, mask, x)
(
  x += tiny; x -= tiny;
  mem[base + ptr] = x;
  (ptr + 1) & mask;
);

function delay_read(base, ptr, mask, D)
(
  // read relative to last-written
  mem[base + ((ptr - 1 - D) & mask)];
);

// Build FIRs once, then only when sliders change
prev_f1 = -1; prev_f2 = -1;
function maybe_update_coeffs()
(
  f1 = slider2; f2 = slider3;
  (f1 != prev_f1) ? (design_lp(f1, TAPS, coeff1_base); prev_f1 = f1;);
  (f2 != prev_f2) ? (design_lp(f2, TAPS, coeff2_base); prev_f2 = f2;);
);
maybe_update_coeffs();

@slider
U = slider1/100;
gamma = 1.2;
beta_m = min(slider4,      pow(U, gamma));
beta_h = min(slider5, 1.2* pow(U, gamma));

// decor delays in samples (cap to buffer size-1)
Dmid = floor(slider6 * 0.001 * srate);
Dhi  = floor(slider7 * 0.001 * srate);
Dmid < 0 ? Dmid = 0;
Dhi  < 0 ? Dhi  = 0;
Dmid > dXm_mask ? Dmid = dXm_mask : Dmid;
Dhi  > dXh_mask ? Dhi  = dXh_mask : Dhi;

// only redesign FIRs if f1/f2 actually changed
maybe_update_coeffs();

wet = slider8;

@sample
// inputs
W = spl0; X = spl1; Y = spl2; Z = spl3;

// push into ring buffers (capture new pointers)
ptrW = push_ring(bufW_base, ptrW, W);
ptrX = push_ring(bufX_base, ptrX, X);
ptrY = push_ring(bufY_base, ptrY, Y);
ptrZ = push_ring(bufZ_base, ptrZ, Z);

// heads (last-written samples)
headW = (ptrW - 1) & buf_mask;
headX = (ptrX - 1) & buf_mask;
headY = (ptrY - 1) & buf_mask;
headZ = (ptrZ - 1) & buf_mask;

// FIR low-passes (use heads)
lp1_W = conv_dot(bufW_base, headW, coeff1_base, TAPS);
lp2_W = conv_dot(bufW_base, headW, coeff2_base, TAPS);
lp1_X = conv_dot(bufX_base, headX, coeff1_base, TAPS);
lp2_X = conv_dot(bufX_base, headX, coeff2_base, TAPS);
lp1_Y = conv_dot(bufY_base, headY, coeff1_base, TAPS);
lp2_Y = conv_dot(bufY_base, headY, coeff2_base, TAPS);
lp1_Z = conv_dot(bufZ_base, headZ, coeff1_base, TAPS);
lp2_Z = conv_dot(bufZ_base, headZ, coeff2_base, TAPS);

// bands
W_low = lp1_W; W_mid = lp2_W - lp1_W; W_hi = W - lp2_W;
X_low = lp1_X; X_mid = lp2_X - lp1_X; X_hi = X - lp2_X;
Y_low = lp1_Y; Y_mid = lp2_Y - lp1_Y; Y_hi = Y - lp2_Y;
Z_low = lp1_Z; Z_mid = lp2_Z - lp1_Z; Z_hi = Z - lp2_Z;

// decor delays (advance pointers and read with last-written reference)
dXm_ptr = delay_push(dXm_base, dXm_ptr, dXm_mask, X_mid);
dYm_ptr = delay_push(dYm_base, dYm_ptr, dYm_mask, Y_mid);
dXh_ptr = delay_push(dXh_base, dXh_ptr, dXh_mask, X_hi);
dYh_ptr = delay_push(dYh_base, dYh_ptr, dYh_mask, Y_hi);

X_mid_d = delay_read(dXm_base, dXm_ptr, dXm_mask, Dmid);
Y_mid_d = delay_read(dYm_base, dYm_ptr, dYm_mask, Dmid);
X_hi_d  = delay_read(dXh_base, dXh_ptr, dXh_mask, Dhi);
Y_hi_d  = delay_read(dYh_base, dYh_ptr, dYh_mask, Dhi);

// Z synthesis
Z_syn_mid = gW_mid_base*W_mid + gX_mid_base*X_mid_d + gY_mid_base*Y_mid_d;
Z_syn_hi  = gW_hi_base *W_hi  + gX_hi_base *X_hi_d  + gY_hi_base *Y_hi_d;

Z_mid_out = Z_mid + beta_m * Z_syn_mid;
Z_hi_out  = Z_hi  + beta_h * Z_syn_hi;

Z_new = Z_low + Z_mid_out + Z_hi_out;

// dry/wet on Z only
Z_final = (1-wet)*Z + wet*Z_new;

// outputs (W/X/Y passthrough)
spl0 = W;
spl1 = X;
spl2 = Y;
spl3 = Z_final;

