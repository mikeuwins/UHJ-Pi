[Unit]
Description=Mac Mini Fan Control Service
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'sleep 10 && echo disabled | tee /sys/class/thermal/thermal_zone0/mode && echo 1 | tee /sys/devices/platform/applesmc.768/fan1_manual && echo 2000 | tee /sys/devices/platform/applesmc.768/fan1_output'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

