/*
ATK FOA Decode 5.1.2 Matrix
FOA (W,X,Y,Z) → Dolby 5.1.2 (FL, FR, C, RL, RR, LFE, TFL, TFR)

Based on 5_0 decoder with periphonic height channels (W,X,Y,Z coefficients)

Copyright the ATK Community and Joseph Anderson, Josh Parmenter, Trond Lossius, 2013
Peak level metering based on code by Phil Burke
*/

desc:ATK FOA Dolby 5.1.2 Matrix v2

import ../../libraries/atk/atk.jsfx-inc

in_pin:W
in_pin:X
in_pin:Y
in_pin:Z

out_pin:FL
out_pin:FR
out_pin:C
out_pin:RL
out_pin:RR
out_pin:LFE
out_pin:TFL
out_pin:TFR

slider1:0<0,2,1{Equal, Focus, Four}>Mode
slider2:0<-36,24,0.1>Centre trim (dB)
slider3:-10<-36,0,0.1>LFE trim (dB)
slider4:100<20,200,1>LFE LPF (Hz)
slider5:5<0,10,1{20 ms, 30 ms, 50 ms, 100 ms, 200 ms, 300 ms, 500 ms, 1 sec, 3 sec, 6 secs}>Peak level decay half time
slider6:45<30,90,1>Height elevation (deg)
slider7:0<0,1,1{UHJ-Pi,Dolby}>Output layout

@init
kMaxNumSpeakers = 8;
memCount = 1024;
matrixDSP = memCount; memCount += 32;
mAngles = memCount; memCount += 5; // 5 bottom speakers
mLedCoordinates = memCount; memCount += 2*4*kNumLeds*kMaxNumSpeakers;
mPeaks = memCount; memCount += kMaxNumSpeakers+1;
mDisplayPeaks = memCount; memCount += kMaxNumSpeakers+1;
memset(mPeaks,0,kMaxNumSpeakers+1); memset(mDisplayPeaks,0,kMaxNumSpeakers+1);
gfx_clear=-1; kRefreshRate = 0.05; mRefreshSampCount = 0; mDoRefresh = 1;
lfeCoeff = exp(-2 * $pi * 100 / srate); lfeGain = 3.16; lfePrev = 0;

// Lower ring 5x4 matrix - Equal (C,FL,RL,RR,FR)
function set_equal_matrix() local(i) (
  i = 0; // FL
  matrixDSP[i*4+0] = 0.365; matrixDSP[i*4+1] = 0.435; matrixDSP[i*4+2] = 0.34; matrixDSP[i*4+3] = 0.0;
  i = 1; // FR
  matrixDSP[i*4+0] = 0.365; matrixDSP[i*4+1] = 0.435; matrixDSP[i*4+2] = -0.34; matrixDSP[i*4+3] = 0.0;
  i = 2; // C
  matrixDSP[i*4+0] = 0.0; matrixDSP[i*4+1] = 0.085; matrixDSP[i*4+2] = 0.0; matrixDSP[i*4+3] = 0.0;
  i = 3; // RL
  matrixDSP[i*4+0] = 0.555; matrixDSP[i*4+1] = -0.285; matrixDSP[i*4+2] = 0.405; matrixDSP[i*4+3] = 0.0;
  i = 4; // RR
  matrixDSP[i*4+0] = 0.555; matrixDSP[i*4+1] = -0.285; matrixDSP[i*4+2] = -0.405; matrixDSP[i*4+3] = 0.0;
);

// Lower ring 5x4 matrix - Focused (C,FL,RL,RR,FR)
function set_focused_matrix() local(i) (
  i = 0; // FL
  matrixDSP[i*4+0] = 0.425; matrixDSP[i*4+1] = 0.36; matrixDSP[i*4+2] = 0.405; matrixDSP[i*4+3] = 0.0;
  i = 1; // FR
  matrixDSP[i*4+0] = 0.425; matrixDSP[i*4+1] = 0.36; matrixDSP[i*4+2] = -0.405; matrixDSP[i*4+3] = 0.0;
  i = 2; // C
  matrixDSP[i*4+0] = 0.2; matrixDSP[i*4+1] = 0.16; matrixDSP[i*4+2] = 0.0; matrixDSP[i*4+3] = 0.0;
  i = 3; // RL
  matrixDSP[i*4+0] = 0.47; matrixDSP[i*4+1] = -0.33; matrixDSP[i*4+2] = 0.415; matrixDSP[i*4+3] = 0.0;
  i = 4; // RR
  matrixDSP[i*4+0] = 0.47; matrixDSP[i*4+1] = -0.33; matrixDSP[i*4+2] = -0.415; matrixDSP[i*4+3] = 0.0;
);

// Lower ring 5x4 matrix - Four (C,FL,RL,RR,FR)
function set_four_matrix() local(i) (
  i = 0; // FL
  matrixDSP[i*4+0] = 0.425; matrixDSP[i*4+1] = 0.385; matrixDSP[i*4+2] = 0.33; matrixDSP[i*4+3] = 0.0;
  i = 1; // FR
  matrixDSP[i*4+0] = 0.425; matrixDSP[i*4+1] = 0.385; matrixDSP[i*4+2] = -0.33; matrixDSP[i*4+3] = 0.0;
  i = 2; // C
  matrixDSP[i*4+0] = 0.0; matrixDSP[i*4+1] = 0.0; matrixDSP[i*4+2] = 0.0; matrixDSP[i*4+3] = 0.0;
  i = 3; // RL
  matrixDSP[i*4+0] = 0.63; matrixDSP[i*4+1] = -0.275; matrixDSP[i*4+2] = 0.285; matrixDSP[i*4+3] = 0.0;
  i = 4; // RR
  matrixDSP[i*4+0] = 0.63; matrixDSP[i*4+1] = -0.275; matrixDSP[i*4+2] = -0.285; matrixDSP[i*4+3] = 0.0;
);

// Heights 2x4 matrix (TFL,TFR) - upper hemisphere decode with spatial width
// Position: ±30° azimuth, variable elevation (adjustable via slider6)
// X: front-back position (same to both, but scales with elevation - represents position change from front to overhead)
// Y: left-right spatial width (opposite signs create stereo width) - scales with elevation
// Z: elevation component - increases with elevation
// W: ambient/omnidirectional component
function set_heights_matrix() local(i, el, az, g1, norm, x_coef, y_coef, z_coef) (
  // Elevation angle from slider (convert degrees to radians)
  el = slider6 * 0.017453292519943; // π/180
  // Azimuth: ±30° for left/right (fixed position)
  az = 30 * 0.017453292519943;
  // First-order gain
  g1 = 1.4142135623731; // √2
  // Normalization factor (same as used in original file)
  norm = 0.577348;
  // Calculate X coefficient (front-back position, normalized, same for both speakers)
  // X scales with elevation: decreases from "in front" to "overhead"
  x_coef = g1 * cos(el) * cos(az) * norm;
  // Calculate Y coefficient (left-right width, normalized, opposite signs)
  // Height speakers maintain same left/right positions (azimuth) regardless of elevation
  // A wide-left sound should stay wide-left whether speakers are at 30° or 90° elevation
  // So Y should remain constant (or nearly so) - speakers don't move left/right, just up/down
  // At 30° elevation, Y matches front speakers (0.34)
  y_at_30deg = 0.34; // Matches front speaker Y coefficient at 30° elevation
  // Keep Y constant: speakers maintain horizontal separation regardless of elevation
  y_coef = y_at_30deg;
  // Calculate Z coefficient (elevation, raw value, not normalized)
  z_coef = g1 * sin(el);
  // W component (normalized omnidirectional)
  i = 5; // TFL - upper hemisphere with left-side width
  matrixDSP[i*4+0] = 0.408248; matrixDSP[i*4+1] = x_coef; matrixDSP[i*4+2] = -y_coef; matrixDSP[i*4+3] = z_coef;
  i = 6; // TFR - upper hemisphere with right-side width
  matrixDSP[i*4+0] = 0.408248; matrixDSP[i*4+1] = x_coef; matrixDSP[i*4+2] = y_coef; matrixDSP[i*4+3] = z_coef;
);

function determine512Geometry()
(
  gCenterX = gfx_w * 0.5;
  gCenterYUpper = gfx_h * 0.25;
  gCenterY = gfx_h * 0.5;
  gCenterYLower = gfx_h * 0.75;
  gCenterX < gCenterYUpper ? gRadius = gCenterX : gRadius = gCenterYUpper;
  gRadius = gRadius - 10;
  gInverseRadius = 1. / gRadius;
);

function draw512LEDBackgroundImage()
(
  gxColorSet(1.0, 0., 0., 0.);
  gfx_rect(0,0,gfx_w,gfx_h);
  gxColorSet(1.0, 0.18, 0.18, 0.18);
  gfx_circle(gCenterX, gCenterYLower, gRadius, 1, 1);
  gfx_circle(gCenterX, gCenterYUpper, gRadius, 1, 1);
  gxColorSet(1.0, 0.35, 0.35, 0.35);
  gfx_circle(gCenterX, gCenterYUpper, 0.15*gRadius, 0, 1);
  gfx_circle(gCenterX, gCenterYUpper, 1.0*gRadius, 0, 1);
  gfx_circle(gCenterX, gCenterYLower, 0.15*gRadius, 0, 1);
  gfx_circle(gCenterX, gCenterYLower, 1.0*gRadius, 0, 1);
);

function calculateLedCoordinates512(aLedCount, anAngleLo, anAngleHi, lowerRing) local(lLedRadius, lY)
(
  lLedRadius = gRadius * 0.2;
  lLedRadInc = (0.8*gRadius) / (2*kNumLeds+1);
  lY = lowerRing ? gCenterYLower : gCenterYUpper;
  loop(kNumLeds,
    mLedCoordinates[aLedCount]     =  gCenterX + cos(anAngleLo) * lLedRadius;
    mLedCoordinates[aLedCount + 1] =  lY - sin(anAngleLo) * lLedRadius;
    mLedCoordinates[aLedCount + 2] =  gCenterX + cos(anAngleHi) * lLedRadius;
    mLedCoordinates[aLedCount + 3] =  lY - sin(anAngleHi) * lLedRadius;
    lLedRadius += lLedRadInc;
    mLedCoordinates[aLedCount + 4] =  gCenterX + cos(anAngleHi) * lLedRadius;
    mLedCoordinates[aLedCount + 5] =  lY - sin(anAngleHi) * lLedRadius;
    mLedCoordinates[aLedCount + 6] =  gCenterX + cos(anAngleLo) * lLedRadius;
    mLedCoordinates[aLedCount + 7] =  lY - sin(anAngleLo) * lLedRadius;
    lLedRadius += lLedRadInc;
    aLedCount += 8;
  );
  aLedCount;
);

function calculateCoordinates512() local(lLedCount)
(
  lLedCount = 0;
  // Bottom layer 1-5: identical to 5_0
  mAngles[0] = 120 * kDeg2Rad;
  lLedCount  = calculateLedCoordinates512(lLedCount, 110 * kDeg2Rad, 130 * kDeg2Rad, 1);
  mAngles[1] =  60 * kDeg2Rad;
  lLedCount  = calculateLedCoordinates512(lLedCount,  50 * kDeg2Rad,  70 * kDeg2Rad, 1);
  mAngles[2] =  90 * kDeg2Rad;
  lLedCount  = calculateLedCoordinates512(lLedCount,  80 * kDeg2Rad, 100 * kDeg2Rad, 1);
  mAngles[3] = 200 * kDeg2Rad;
  lLedCount  = calculateLedCoordinates512(lLedCount, 180 * kDeg2Rad, 220 * kDeg2Rad, 1);
  mAngles[4] = 340 * kDeg2Rad;
  lLedCount  = calculateLedCoordinates512(lLedCount, 320 * kDeg2Rad, 360 * kDeg2Rad, 1);
  // Upper layer 7-8: FL/FR positions
  lLedCount  = calculateLedCoordinates512(lLedCount, 110 * kDeg2Rad, 130 * kDeg2Rad, 0);
  lLedCount  = calculateLedCoordinates512(lLedCount,  50 * kDeg2Rad,  70 * kDeg2Rad, 0);
);

@slider
// Generate matrix based on mode
slider1 == 0 ? (
    set_equal_matrix();
) : (
  slider1 == 1 ? (
    set_focused_matrix();
  ) : (
    set_four_matrix();
  );
);
set_heights_matrix();

centerGain = 10^(slider2/20);
lfeGain = 10^(slider3/20) * 3.16;
lfeCoeff = exp(-2 * $pi * slider4 / srate);
(slider5 == 0) ? (mPeakScalar = 0.02) :
(slider5 == 1) ? (mPeakScalar = 0.03) :
(slider5 == 2) ? (mPeakScalar = 0.05) :
(slider5 == 3) ? (mPeakScalar = 0.10) :
(slider5 == 4) ? (mPeakScalar = 0.20) :
(slider5 == 5) ? (mPeakScalar = 0.30) :
(slider5 == 6) ? (mPeakScalar = 0.50) :
(slider5 == 7) ? (mPeakScalar = 1.00) :
(slider5 == 8) ? (mPeakScalar = 3.00) :
(slider5 == 9) ? (mPeakScalar = 6.00);
mPeakScalar = pow( 0.5, 1.0/(mPeakScalar * srate));

@sample
wIn = spl0; xIn = spl1; yIn = spl2; zIn = spl3;

// Decode lower ring (FL, FR, C, RL, RR) - indices 0-4
i = 0;
loop(7,
  decOut[i] = wIn * matrixDSP[i*4 + 0] + xIn * matrixDSP[i*4 + 1] + yIn * matrixDSP[i*4 + 2] + zIn * matrixDSP[i*4 + 3];
  i += 1;
);

// LFE from horizontal speakers
lfeInput = decOut[0] + decOut[1] + decOut[2] + decOut[3] + decOut[4];
lfeOut = lfeInput + (lfePrev - lfeInput) * lfeCoeff;
lfePrev = lfeOut;

// Output mapping based on layout selection
// decOut indices: [0]=FL, [1]=FR, [2]=C, [3]=RL, [4]=RR, [5]=TFL, [6]=TFR
layout = slider7|0; // 0=UHJ-Pi, 1=Dolby
layout == 0 ? (
  // UHJ-Pi layout: FL, FR, C, RL, RR, LFE, TFL, TFR
  spl0 = decOut[0]; spl1 = decOut[1]; spl2 = decOut[2] * centerGain;
  spl3 = decOut[3]; spl4 = decOut[4]; spl5 = lfeOut * lfeGain;
  spl6 = decOut[5]; spl7 = decOut[6];
) : (
  // Dolby layout: L, R, C, LFE, Ls, Rs, TFL, TFR
  spl0 = decOut[0]; spl1 = decOut[1]; spl2 = decOut[2] * centerGain;
  spl3 = lfeOut * lfeGain; spl4 = decOut[3]; spl5 = decOut[4];
  spl6 = decOut[5]; spl7 = decOut[6];
);

// Peak metering
ispl = 0;
loop(8,
  input = spl(ispl);
  output = mPeaks[ispl];
  input = abs(input);
  ( input >= output ) ? (output = input) : (output = output * mPeakScalar);
  mPeaks[ispl] = output;
  mDisplayPeaks[ispl] = max(mDisplayPeaks[ispl], output);
  ispl += 1;
);

@block
(mRefreshSampCount > kRefreshRate*srate) ? (mDoRefresh = 1) : (mRefreshSampCount += samplesblock);

@gfx 500 600
determine512Geometry();
gRadius -= 30;
geometryHasChanged(mPrevWidth, mPrevHeight) ? (
  draw512LEDBackgroundImage();
  setSpeakerPositionFont();
  calculateCoordinates512();
  gfx_setfont(1,"Verdana", 12);
  // Bottom layer 1-5
  drawSpeakerPositiion(gCenterX + (gRadius+20)*cos(mAngles[0]), gCenterYLower - (gRadius+20)*sin(mAngles[0]), "1");
  drawSpeakerPositiion(gCenterX + (gRadius+20)*cos(mAngles[1]), gCenterYLower - (gRadius+20)*sin(mAngles[1]), "2");
  drawSpeakerPositiion(gCenterX + (gRadius+20)*cos(mAngles[2]), gCenterYLower - (gRadius+20)*sin(mAngles[2]), "3");
  drawSpeakerPositiion(gCenterX + (gRadius+20)*cos(mAngles[3]), gCenterYLower - (gRadius+20)*sin(mAngles[3]), "4");
  drawSpeakerPositiion(gCenterX + (gRadius+20)*cos(mAngles[4]), gCenterYLower - (gRadius+20)*sin(mAngles[4]), "5");
  // Upper layer 7-8
  drawSpeakerPositiion(gCenterX + (gRadius+20)*cos(120*kDeg2Rad), gCenterYUpper - (gRadius+20)*sin(120*kDeg2Rad), "7");
  drawSpeakerPositiion(gCenterX + (gRadius+20)*cos(60*kDeg2Rad), gCenterYUpper - (gRadius+20)*sin(60*kDeg2Rad), "8");
  // LFE label in center of lower circle (6)
  gxColorSet(1.0, 0.9, 0.9, 0.9);
  gfx_setfont(1,"Verdana", 11);
  gfx_measurestr("6", lW, lH);
  gfx_x = gCenterX - 0.5*lW; gfx_y = gCenterYLower - 0.5*lH; gfx_drawstr("6");
  mPrevWidth = gfx_w; mPrevHeight = gfx_h; mDoRefresh = 1;
);

(mDoRefresh) ? (
  // Bottom layer: 0-4 (FL, FR, C, RL, RR)
  drawSpkrLEDs(amp2db(mDisplayPeaks[0]), 0, mLedCoordinates);
  drawSpkrLEDs(amp2db(mDisplayPeaks[1]), 1, mLedCoordinates);
  drawSpkrLEDs(amp2db(mDisplayPeaks[2]), 2, mLedCoordinates);
  drawSpkrLEDs(amp2db(mDisplayPeaks[3]), 3, mLedCoordinates);
  drawSpkrLEDs(amp2db(mDisplayPeaks[4]), 4, mLedCoordinates);
  // Top layer: 6-7 (TFL, TFR) -> LEDs 5-6
  drawSpkrLEDs(amp2db(mDisplayPeaks[6]), 5, mLedCoordinates);
  drawSpkrLEDs(amp2db(mDisplayPeaks[7]), 6, mLedCoordinates);
  memset(mDisplayPeaks, 0., 8.);
  mRefreshSampCount = 0; mDoRefresh = 0;
);
