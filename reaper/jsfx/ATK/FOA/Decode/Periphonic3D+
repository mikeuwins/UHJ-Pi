---------------------------------------------------------------------
  Class: periphonic
  A periphonic 3D decoder
  
  Periphonic (3D) dual ring, regular cylindrical decoder
  (Patched)
   • Lower ring behaves exactly like Pantophonic 2D at ear height
   • When elevation=0°, top ring also forced to Pantophonic (to match levels)
   • Optional auto-gate mutes upper ring until Z energy is present
---------------------------------------------------------------------
*/


desc: ATK FOA Decode Periphonic 3D
// Periphonic (3D) dual ring, regular cylindrical decoder


// Import library with shared functions, also imports cookdsp
import ../../libraries/atk/atk.jsfx-inc


in_pin:W
in_pin:X
in_pin:Y
in_pin:Z

out_pin:1
out_pin:2
out_pin:3
out_pin:4
out_pin:5
out_pin:6
out_pin:7
out_pin:8
out_pin:9
out_pin:10
out_pin:11
out_pin:12
out_pin:13
out_pin:14
out_pin:15
