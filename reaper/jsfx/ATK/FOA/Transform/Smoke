/*
ATK FOA Transform - BVHAP Z-row SMOKE (no kernels)
Goal: prove the FOA chain/decoder can render "from above" with a simple donor mix.

Z' = Z + Amount * BP( 0.6*W + 0.2*X + 0.2*Y )

- Minimum-phase IIR bandpass (~700 Hz–8 kHz) on donors: "height-ish" band
- Dry Z is NOT delayed (IIR path is minimum-phase; near-zero perceived latency)
- Z-Solo: only injected component on Z (W/X/Y muted)

If this does NOT lift clearly, the issue is downstream (decoder/virtualiser/routing).
*/

desc: ATK FOA Transform - BVHAP Z SMOKE

in_pin:W
in_pin:X
in_pin:Y
in_pin:Z

out_pin:W
out_pin:X
out_pin:Y
out_pin:Z

slider1:1<0,1,1{Off,On}>Enable
slider2:50<0,100,1>Amount (%)
slider3:0<-18,18,0.1>Z-Added Trim (dB)
slider4:0<0,1,1{Normal,Invert}>Polarity
slider5:0<0,1,1{Off,On}>Z-Solo

@init
// simple 1st-order HP + LP (cascaded) to form band ~700-8000 Hz
function onepole_hp(x, st*, alpha)(st[0] = alpha*st[0] + alpha*(x - st[1]); st[1] = x; onepole_hp = st[0];);
function onepole_lp(x, st*, alpha)(st[0] = (1-alpha)*x + alpha*st[0]; onepole_lp = st[0];);

hp_fc = 700; lp_fc = 8000;
hp_a = exp(-2*$pi*hp_fc/srate);
lp_a = exp(-2*$pi*lp_fc/srate);

// states: hp then lp per donor
memset(hpW,0,3); memset(lpW,0,3);
memset(hpX,0,3); memset(lpX,0,3);
memset(hpY,0,3); memset(lpY,0,3);

@slider
enable = slider1|0;
amt    = slider2/100;
gtrim  = 2^(slider3/6);
pol    = (slider4|0)==0 ? 1 : -1;
zsolo  = slider5|0;

@sample
W = spl0; X = spl1; Y = spl2; Z = spl3;

// bandshape donors (min-phase)
dW = onepole_lp(onepole_hp(W, hpW, hp_a), lpW, lp_a);
dX = onepole_lp(onepole_hp(X, hpX, hp_a), lpX, lp_a);
dY = onepole_lp(onepole_hp(Y, hpY, hp_a), lpY, lp_a);

// simple weights (same as your mid/high bases)
zinj = (0.6*dW + 0.2*dX + 0.2*dY) * (enable ? amt*gtrim*pol : 0);

zsolo ? (
  spl0=0; spl1=0; spl2=0; spl3=zinj;
) : (
  spl0=W; spl1=X; spl2=Y; spl3=Z + zinj;
);
